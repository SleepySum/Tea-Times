# ---------------------------------------------------------------------------
# Tea-Times — Environment Variables
# ---------------------------------------------------------------------------
# Copy this file to .env.local (gitignored) and fill in the values.
# NEVER commit .env.local or any file containing real secrets.
# ---------------------------------------------------------------------------

# Required — MongoDB connection string (ATLAS_URI or self-hosted)
# Example: mongodb+srv://<user>:<password>@cluster.mongodb.net/tea-times
MONGODB_URI=

# Optional — database name. Defaults to "tea-times" if omitted.
MONGODB_DB=tea-times

# Optional — comma-separated list of allowed client IPs.
# When set, any request from an IP not on this list receives 403.
# Leave empty (default) to allow all IPs during development.
# Example: ALLOWED_IPS=127.0.0.1,192.168.1.100
ALLOWED_IPS=

# Optional — Vercel deployment URL (set automatically by Vercel).
# Used by middleware to enable HSTS headers only on production.
# VERCEL_URL is injected automatically; no need to set manually.
